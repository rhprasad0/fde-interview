            "attributes": {
                "content": "[{\"toolResult\": {\"status\": \"success\", \"toolUseId\": \"toolu_014gXdDHY8wxkphkKaCkkWFy\", \"content\": [{\"text\": \"{\\\"is_truncated\\\":false,\\\"columns\\\":[\\\"bucket\\\",\\\"headcount\\\",\\\"share\\\",\\\"source_file\\\"],\\\"rows\\\":[[\\\"<1\\\",5649,0.0797,\\\"employment_202608_1.parquet\\\"],[\\\"1-3\\\",5676,0.0801,\\\"employment_202608_1.parquet\\\"],[\\\"3-5\\\",4778,0.0674,\\\"employment_202608_1.parquet\\\"],[\\\"5-10\\\",10850,0.1532,\\\"employment_202608_1.parquet\\\"],[\\\"10-20\\\",23414,0.3305,\\\"employment_202608_1.parquet\\\"],[\\\"20+\\\",20476,0.289,\\\"employment_202608_1.parquet\\\"]]}\"}], \"structuredContent\": {\"is_truncated\": false, \"columns\": [\"bucket\", \"headcount\", \"share\", \"source_file\"], \"rows\": [[\"<1\", 5649, 0.0797, \"employment_202608_1.parquet\"], [\"1-3\", 5676, 0.0801, \"employment_202608_1.parquet\"], [\"3-5\", 4778, 0.0674, \"employment_202608_1.parquet\"], [\"5-10\", 10850, 0.1532, \"employment_202608_1.parquet\"], [\"10-20\", 23414, 0.3305, \"employment_202608_1.parquet\"], [\"20+\", 20476, 0.289, \"employment_202608_1.parquet\"]]}, \"isError\": false}}]"
