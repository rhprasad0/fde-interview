tional_series_code,\\\\n  series_counts.occupational_series,\\\\n  series_counts.headcount,\\\\n  series_counts.headcount_20_plus_years,\\\\n  SUM(series_counts.headcount) OVER () AS total_headcount_all_series\\\\nFROM series_counts\\\\nORDER BY series_counts.headcount DESC, series_counts.occupational_series_code, series_counts.occupational_series\\\", \\\"statement_id\\\": \\\"01f1d64d-8086-176b-953a-2d73a81757ff\\\", \\\"message_id\\\": \\\"01f1d64d7a1219b6a01cf4a2bcf62e8a\\\", \\\"columns\\\": [\\\"occupational_series_code\\\", \\\"occupational_series\\\", \\\"headcount\\\", \\\"headcount_20_plus_years\\\", \\\"total_headcount_all_series\\\"], \\\"rows\\\": [[\\\"1895\\\", \\\"CUSTOMS AND BORDER PROTECTION\\\", 27650, 8732, 70843], [\\\"1896\\\", \\\"BORDER PATROL ENFORCEMENT SERIES\\\", 22464, 5513, 70843], [\\\"0401\\\", \\\"GENERAL NATURAL RESOURCES MANAGEMENT AND BIOLOGICAL SCIENCES\\\", 2833, 852, 70843], [\\\"1801\\\", \\\"GENERAL INSPECTION, INVESTIGATION, ENFORCEMENT, AND COMPLIANCE SERIES\\\", 2247, 910, 70843], [\\\"0301\\\", \\\"MISCELLANEOUS ADMINISTRATION AND PROGRAM\\\", 2017, 642, 70843], [\\\"1802\\\", \\\"COMPLIANCE INSPECTION AND SUPPORT\\\", 1958, 223, 70843], [\\\"0343\\\", \\\"MANAGEMENT AND PROGRAM ANALYSIS\\\", 1446, 478, 70843], [\\\"2210\\\", \\\"INFORMATION TECHNOLOGY MANAGEMENT\\\", 1235, 228, 70843], [\\\"1889\\\", \\\"IMPORT COMPLIANCE SERIES\\\", 1120, 405, 70843], [\\\"0340\\\", \\\"PROGRAM MANAGEMENT\\\", 951, 429, 70843], [\\\"1881\\\", \\\"CUSTOMS AND BORDER PROTECTION INTERDICTION\\\", 601, 191, 70843], [\\\"0201\\\", \\\"HUMAN RESOURCES MANAGEMENT\\\", 484, 120, 70843], [\\\"0132\\\", \\\"INTELLIGENCE\\\", 460, 120, 70843], [\\\"0905\\\", \\\"GENERAL ATTORNEY\\\", 454, 103, 70843], [\\\"1894\\\", \\\"CUSTOMS ENTRY AND LIQUIDATING\\\", 423, 202, 70843], [\\\"1811\\\", \\\"CRIMINAL INVESTIGATION\\\", 403, 178, 70843], [\\\"0950\\\", \\\"PARALEGAL SPECIALIST\\\", 366, 122, 70843], [\\\"0511\\\", \\\"AUDITING\\\", 345, 116, 70843],