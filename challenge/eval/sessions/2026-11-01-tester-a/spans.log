00\\\",\\\"HSBD\\\",\\\"CBP Officer (NTC)\\\",\\\"13\\\",\\\"13\\\",null,\\\"Many\\\",[\\\"Virginia\\\"],\\\"2026-07-07\\\",\\\"2027-01-04\\\"]]}\"}], \"structuredContent\": {\"is_truncated\": false, \"columns\": [\"control_number\", \"agency_subelement_code\", \"position_title\", \"minimum_grade\", \"maximum_grade\", \"total_openings\", \"total_openings_raw\", \"states\", \"open_date\", \"close_date\"], \"rows\": [[\"878106500\", \"HSBD\", \"Supervisory CBP Officer (Assistant Port Director)\", \"14\", \"14\", 1, \"1\", [null], \"2026-07-28\", \"2026-08-03\"], [\"876574600\", \"HSBD\", \"CBP OFFICER (INTERNATIONAL)\", \"12\", \"12\", 1, \"1\", [null], \"2026-07-29\", \"2026-08-04\"], [\"878107200\", \"HSBD\", \"Supervisory CBP Officer (Assistant Port Director)\", \"14\", \"14\", 1, \"1\", [\"Vermont\"], \"2026-07-29\", \"2026-08-04\"], [\"878130300\", \"HSBD\", \"CBP Officer (Program Manager)\", \"14\", \"14\", 1, \"1\", [null], \"2026-07-29\", \"2026-08-04\"], [\"878298400\", \"HSBD\", \"Supervisory CBP Officer (Canine)\", \"13\", \"13\", 1, \"1\", [\"New Mexico\"], \"2026-07-29\", \"2026-08-04\"], [\"878393100\", \"HSBD\", \"CBP OFFICER (BORDER SECURITY)\", \"13\", \"13\", 1, \"1\", [\"Texas\"], \"2026-07-30\", \"2026-08-05\"], [\"878416800\", \"HSBD\", \"Supervisory Customs & Border Protecton Officer (Canine)\", \"13\", \"13\", 1, \"1\", [\"New York\"], \"2026-07-30\", \"2026-08-05\"], [\"878683600\", \"HSBD\", \"CBP OFFICER (NTC)\", \"12\", \"12\", 1, \"1\", [\"Virginia\"], \"2026-07-31\", \"2026-08-06\"], [\"878058100\", \"HSBD\", \"Customs and Border Protection Officer\", \"5\", \"7\", null, \"Many\", [null], \"2026-08-01\", \"2026-08-31\"], [\"878058600\", \"HSBD\", \"Customs and Border Protection Officer\", \"9\", \"9\", null, \"Many\", [null], \"2026-08-01\", \"2026-08-31\"], [\"875468500\", \"HSBD\", \"CBP Officer (NTC)\", \"13\", \"13\", null, \"Many\", [\"Virginia\"], \"2026-07-07\", \"2027-01-04\"]]}, \"isError\": false}}]"
