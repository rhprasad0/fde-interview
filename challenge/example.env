# Copy to challenge/.env (gitignored) and fill in. Never commit real values.
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=<warehouse-id>   # spec 01 imports it into Terraform; later specs query it
DATABRICKS_CLIENT_ID=<service-principal-application-id>
DATABRICKS_CLIENT_SECRET=<oauth-secret>
