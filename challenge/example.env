# Copy to challenge/.env (gitignored) and fill in. Never commit real values.
# The PG* and AGENT_PG* lines come from `terraform -chdir=challenge/infra output -raw pg_env` (spec 06).
PGHOST=<rds-endpoint>                   # spec 06: the workforce database; owner role for loading, truth, refresh
PGPORT=5432
PGDATABASE=workforce
PGUSER=workforce
PGPASSWORD=<master-password>
PGSSLMODE=require
AGENT_PGUSER=agent                      # spec 06: the read-only role the agent's tools connect as
AGENT_PGPASSWORD=<agent-password>
# No USAJOBS key: spec 02 loads the Historic JOA, which needs none (DECISIONS.md, Data, amended).
ANTHROPIC_API_KEY=<anthropic-api-key>   # spec 05: the prototype agent (Claude Haiku 5.5)
OPENAI_API_KEY=<openai-api-key>         # spec 04: the eval judge (gpt-6-luna)
