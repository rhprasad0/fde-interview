# Copy to challenge/.env (gitignored) and fill in. Never commit real values.
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=<warehouse-id>   # spec 01 imports it into Terraform; later specs query it
DATABRICKS_CLIENT_ID=<service-principal-application-id>
DATABRICKS_CLIENT_SECRET=<oauth-secret>
# No USAJOBS key: spec 02 loads the Historic JOA, which needs none (DECISIONS.md, Data, amended).
DATABRICKS_LOAD_JOB_ID=<job-id>          # spec 02: workforce-02-load
DATABRICKS_SEMANTIC_JOB_ID=<job-id>      # spec 03: workforce-03-semantic
DATABRICKS_GENIE_SPACE_ID=<space-id>     # spec 03: the DHS workforce Genie space; spec 04 fronts it with the Gateway
ANTHROPIC_API_KEY=<anthropic-api-key>       # spec 05: the prototype agent (Claude Haiku 5.5) and the eval judge
