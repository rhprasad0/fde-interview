#!/bin/sh
# Public repo: commit messages must not contain a term from the gitignored .forbidden-terms.
terms=.forbidden-terms
[ -s "$terms" ] || { echo "commit-msg: $terms is missing or empty; refusing to commit" >&2; exit 1; }
if grep -iFf "$terms" "$1"; then
  echo "commit-msg: message contains a forbidden term (see $terms)" >&2
  exit 1
fi
