#!/bin/sh
# Public repo: block staged additions (content or file paths) containing a term from the gitignored .forbidden-terms.
terms=.forbidden-terms
[ -s "$terms" ] || { echo "pre-commit: $terms is missing or empty; refusing to commit" >&2; exit 1; }
if git diff --cached -U0 --no-color | grep '^+' | grep -iFf "$terms"; then
  echo "pre-commit: staged changes contain a forbidden term (see $terms)" >&2
  exit 1
fi
